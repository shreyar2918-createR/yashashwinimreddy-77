      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "fullName": { "type": "string", "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": ["client", "admin", "super_admin", "project_manager", "content_admin"]
