    "OtpRequest": {
      "title": "OtpRequest",
      "description": "Transient verification attempt records managed server-side",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "identifier": { "type": "string", "maxLength": 254 },
        "type": { "type": "string", "enum": ["email", "phone"] },
        "otpHash": { "type": "string", "maxLength": 128 },
        "salt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "cooldownUntil": { "type": "string", "format": "date-time" },
        "attempts": { "type": "number" },
        "maxAttempts": { "type": "number" },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "consumed",
            "expired",
            "invalidated",
            "max_attempts_exceeded"
          ]
        },
        "consumed": { "type": "boolean" },
        "verificationToken": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "identifier",
        "type",
        "otpHash",
        "salt",
        "expiresAt",
        "attempts",
        "consumed",
        "status",
        "createdAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "link": { "type": "string", "maxLength": 400 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "body", "read", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "System and user audit trail record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "maxLength": 80 },
        "targetId": { "type": "string", "maxLength": 128 },
        "metadata": { "type": "object" },
        "ipHash": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorId", "action", "targetType", "timestamp"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct communication thread between client and VINORA admin team",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 120 },
        "clientEmail": { "type": "string", "maxLength": 254 },
        "adminUid": { "type": "string", "maxLength": 128 },
        "adminName": { "type": "string", "maxLength": 120 },
        "adminEmail": { "type": "string", "maxLength": 254 },
        "lastMessageText": { "type": "string", "maxLength": 2000 },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "lastSenderRole": { "type": "string", "enum": ["client", "admin"] },
        "lastSenderUid": { "type": "string", "maxLength": 128 },
        "lastSenderName": { "type": "string", "maxLength": 120 },
        "unreadCountClient": { "type": "integer" },
        "unreadCountAdmin": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "clientId",
        "clientName",
        "clientEmail",
        "lastMessageText",
        "lastMessageTimestamp",
        "lastSenderRole",
        "unreadCountClient",
        "unreadCountAdmin",
        "createdAt",
        "updatedAt"
      ]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Individual message inside a client-admin conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderEmail": { "type": "string", "maxLength": 254 },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["client", "admin"] },
        "recipientRole": { "type": "string", "enum": ["admin", "client"] },
        "text": { "type": "string", "maxLength": 4000 },
        "read": { "type": "boolean" },
        "readAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "conversationId",
        "clientId",
        "senderUid",
        "senderEmail",
        "senderName",
        "senderRole",
        "recipientRole",
        "text",
        "read",
        "createdAt"
      ]
    }
  },
